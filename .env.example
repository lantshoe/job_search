# Your self-hosted LLM (e.g. Colab + Cloudflare tunnel). You can also paste or
# change the link on the web page (the "LLM" button), which overrides these.
LLM_BASE_URL=https://your-tunnel.trycloudflare.com
# Model name; leave empty to use the first model the server lists
LLM_MODEL=
# auto | ollama | openai (OpenAI-compatible: vLLM, llama.cpp, LM Studio)
LLM_KIND=auto
# Only if your server requires one (e.g. vLLM --api-key)
LLM_API_KEY=

# MyGreenhouse keyword search (sources.greenhouse_search in config.yaml).
# Copy from your logged-in browser: DevTools > Network > a my.greenhouse.io request >
# Request Headers > "cookie" (whole value) and "user-agent".
GREENHOUSE_COOKIE=
GREENHOUSE_USER_AGENT=

DB_PATH=data/jobs.db
CONFIG_PATH=config.yaml
